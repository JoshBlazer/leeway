<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <DatasyncVersion>10.1.2</DatasyncVersion>
    <EfCoreVersion>10.0.14</EfCoreVersion>
    <AvaloniaVersion>12.1.5</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup Label="Datasync (pinned, see ADR-0002)">
    <PackageVersion Include="CommunityToolkit.Datasync.Client" Version="$(DatasyncVersion)" />
    <PackageVersion Include="CommunityToolkit.Datasync.Server" Version="$(DatasyncVersion)" />
    <PackageVersion Include="CommunityToolkit.Datasync.Server.EntityFrameworkCore" Version="$(DatasyncVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
  </ItemGroup>
  <ItemGroup Label="Transitive security pins (see ADR-0008)">
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Samples only">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup Label="Compile-time Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <!-- Do not upgrade past 32.x without an ADR: see ADR-0009 (33.x is not MIT and fails the build without a fee declaration). -->
    <PackageVersion Include="Verify" Version="32.0.1" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
